{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hamdyahmedalfouad/AR-PMP-Question-Bank/blob/main/schema/question.schema.json",
  "title": "AR-PMP Question",
  "description": "A single PMP practice question in the AR-PMP-Question-Bank. Questions are original; sources are cited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "task",
    "type",
    "question",
    "options",
    "answer",
    "explanation",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{4,}$",
      "description": "Unique ID: DOMAIN-TASK-NNNN, e.g. PROCESS-SCHEDULE-0001."
    },
    "domain": {
      "type": "string",
      "enum": ["people", "process", "business-environment"],
      "description": "PMBOK Guide 7th ed. performance domain."
    },
    "task": {
      "type": "string",
      "description": "Concise task label within the domain, e.g. 'Manage conflict'."
    },
    "type": {
      "type": "string",
      "enum": ["multiple-choice", "multi-answer"],
      "description": "multiple-choice = single best answer; multi-answer = choose all that apply."
    },
    "stimulus": {
      "type": "string",
      "description": "Optional scenario text the question refers to."
    },
    "question": {
      "type": "string",
      "minLength": 10,
      "description": "The question stem."
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Answer choices. Keep them parallel in form and length where possible."
    },
    "answer": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        {
          "type": "array",
          "minItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        }
      ],
      "description": "Index (or array of indexes for multi-answer) into options."
    },
    "explanation": {
      "type": "string",
      "minLength": 20,
      "description": "AR-style explanation: the best answer, why it is best, and why the others are wrong."
    },
    "source": {
      "type": "string",
      "description": "Provenance, e.g. 'AR Udemy — Unit 3: Mindset'. Never a verbatim copy of copyrighted text."
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "agile", "predictive", "hybrid", "mindset", "exam-strategy",
          "integration", "scope", "schedule", "cost", "quality",
          "resources", "communications", "risk", "procurement", "stakeholders",
          "conflict", "leadership", "ethics"
        ]
      }
    }
  },
  "if": {
    "properties": { "type": { "const": "multi-answer" } }
  },
  "then": {
    "properties": {
      "answer": { "type": "array", "minItems": 2 }
    }
  },
  "else": {
    "properties": {
      "answer": { "type": "integer" }
    }
  }
}